# ─────────────────────────────────────────────────────────────
#  Après Sea Charters — environment variables
#  Copy this file to ".env.local" and fill in the values.
#  NEVER commit .env.local or share these keys publicly.
# ─────────────────────────────────────────────────────────────

# Resend API key — powers the inquiry emails.
# Get one free at https://resend.com  (Dashboard → API Keys)
RESEND_API_KEY=

# The verified "from" address emails are sent as.
# Must be on a domain you've verified in Resend (see DEPLOY.md).
# Example: "Après Sea <hello@apresseacharters.com>"
# If left blank in development, Resend's shared "onboarding@resend.dev" is used.
INQUIRY_FROM=

# (Optional) Override where inquiries are delivered.
# Defaults to the "email" set in content.ts (info@apresseacharters.com).
INQUIRY_TO=
